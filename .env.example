# Copy to .env and fill in once the Sanity project exists (sanity.io/manage).
# Site (Astro)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Full address of the live site, for share links. Optional on Vercel, which provides its production domain.
PUBLIC_SITE_URL=
# Studio (sanity/)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
