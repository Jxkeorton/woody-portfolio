---
import type { SiteSettings } from '../utils/siteSettings.types';

interface Props {
	settings: Pick<SiteSettings, 'name' | 'email' | 'linkedinUrl' | 'contactHeading'>;
}

const { name, email, linkedinUrl, contactHeading } = Astro.props.settings;
const year = new Date().getFullYear();
---

<footer id="contact">
	<div class="inner">
		<h2>{contactHeading}</h2>
		{email && <a class="email" href={`mailto:${email}`}>{email}</a>}
		{linkedinUrl && (
			<a class="linkedin" href={linkedinUrl} rel="noopener">
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
					/>
				</svg>
				LinkedIn
			</a>
		)}
		<p class="label">&copy; {year} {name}. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		margin-block-start: var(--space-2xl);
		padding: var(--space-xl) var(--gutter) var(--space-l);
		border-block-start: var(--border-hairline);
	}

	.inner {
		display: grid;
		gap: var(--space-m);
		max-inline-size: var(--content-width);
		margin-inline: auto;
	}

	h2 {
		max-inline-size: 16ch;
		font-size: var(--step-3);
		line-height: var(--leading-snug);
		letter-spacing: -0.02em;
	}

	.email {
		inline-size: fit-content;
		min-block-size: var(--tap-target);
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--step-0);
		color: var(--color-accent);
		text-underline-offset: 0.35em;
	}

	.linkedin {
		inline-size: fit-content;
		min-block-size: var(--tap-target);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		font-family: var(--font-mono);
		font-size: var(--step-0);
		color: var(--color-accent);
		text-underline-offset: 0.35em;
	}

	.linkedin svg {
		flex: none;
		color: var(--color-linkedin);
	}

	.label {
		margin-block-start: var(--space-l);
	}
</style>
