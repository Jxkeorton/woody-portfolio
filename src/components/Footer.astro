---
import type { SiteSettings } from '../utils/siteSettings.types';

interface Props {
	settings: Pick<SiteSettings, 'name' | 'email' | 'contactHeading'>;
}

const { name, email, contactHeading } = Astro.props.settings;
const year = new Date().getFullYear();
---

<footer id="contact">
	<div class="inner">
		<h2>{contactHeading}</h2>
		{email && <a class="email" href={`mailto:${email}`}>{email}</a>}
		<p class="label">&copy; {year} {name}. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		margin-block-start: var(--space-2xl);
		padding: var(--space-xl) var(--gutter) var(--space-l);
		border-block-start: var(--border-hairline);
	}

	.inner {
		display: grid;
		gap: var(--space-m);
		max-inline-size: var(--content-width);
		margin-inline: auto;
	}

	h2 {
		max-inline-size: 16ch;
		font-size: var(--step-3);
		line-height: var(--leading-snug);
		letter-spacing: -0.02em;
	}

	.email {
		inline-size: fit-content;
		min-block-size: var(--tap-target);
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--step-0);
		color: var(--color-accent);
		text-underline-offset: 0.35em;
	}

	.label {
		margin-block-start: var(--space-l);
	}
</style>
