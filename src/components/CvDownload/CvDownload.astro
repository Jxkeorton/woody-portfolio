---
import { formatFileSize } from '../../utils/cv';
import type { CvFile } from '../../utils/cv.types';

interface Props {
	file?: CvFile;
	/** Used for the saved file name, for example Woody-Orton-CV.pdf. */
	name: string;
}

const { file, name } = Astro.props;

const fileName = `${name.trim().replace(/\s+/g, '-')}-CV.pdf`;
const href = file && `${file.url}?dl=${encodeURIComponent(fileName)}`;
const details = ['PDF', file?.size ? formatFileSize(file.size) : undefined].filter(Boolean).join(', ');
---

{
	href && (
		<div class="download">
			<a href={href}>
				<span>Download CV</span>
				<span class="label">{details}</span>
			</a>
		</div>
	)
}

<style>
	.download {
		max-inline-size: var(--content-width);
		margin-inline: auto;
		padding: var(--space-l) var(--gutter) 0;
	}

	/* Lines up with the text column of the Experience and Education sections above it. */
	@media (min-width: 56rem) {
		.download {
			display: grid;
			grid-template-columns: 1fr 2fr;
			column-gap: var(--space-2xl);
		}

		a {
			grid-column: 2;
		}
	}

	a {
		display: inline-flex;
		align-items: baseline;
		gap: var(--space-s);
		min-block-size: var(--tap-target);
		padding: var(--space-xs) var(--space-m);
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-pill);
		font-size: var(--step-0);
		text-decoration: none;
		color: var(--color-accent);
		transition:
			background var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	a::after {
		content: '↓';
	}

	a:hover {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	a:hover .label {
		color: inherit;
	}
</style>
