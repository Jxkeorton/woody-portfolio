---
interface Props {
	variant: 'rotor' | 'curve' | 'section' | 'gear';
	caption: string;
}

const { variant, caption } = Astro.props;
---

<figure>
	<svg viewBox="0 0 400 300" role="img" aria-label={caption} fill="none" stroke="currentColor">
		{
			variant === 'rotor' && (
				<>
					<circle cx="200" cy="140" r="115" stroke-width="1.25" />
					<circle cx="200" cy="140" r="92" stroke-width="0.75" />
					<circle cx="200" cy="140" r="38" stroke-width="1.25" />
					<circle cx="200" cy="140" r="12" stroke-width="0.75" />
					{[0, 72, 144, 216, 288].map((deg) => (
						<circle
							cx={200 + 25 * Math.sin((deg * Math.PI) / 180) * 1.6}
							cy={140 - 25 * Math.cos((deg * Math.PI) / 180) * 1.6}
							r="5"
							stroke-width="0.75"
						/>
					))}
					<path d="M200 10v260M60 140h280" stroke-width="0.5" stroke-dasharray="10 4 2 4" />
					<path d="M85 285h230M85 279v12M315 279v12" stroke-width="0.75" />
					<text x="200" y="274" text-anchor="middle" class="dim">Ø 340</text>
				</>
			)
		}
		{
			variant === 'curve' && (
				<>
					<path d="M50 30v230h310" stroke-width="1.25" />
					<path
						d="M50 40H360M50 85H360M50 130H360M50 175H360M50 220H360"
						stroke-width="0.5"
						stroke-dasharray="2 5"
					/>
					<path d="M50 230C110 150 160 70 230 62S320 90 360 140" stroke-width="1.5" />
					<path d="M50 245C120 215 200 140 280 95S340 60 360 70" stroke-width="0.75" stroke-dasharray="5 4" />
					<path d="M230 62V260" stroke-width="0.5" stroke-dasharray="10 4 2 4" />
					<text x="236" y="56" class="dim">peak</text>
					<text x="50" y="280" class="dim">rpm</text>
				</>
			)
		}
		{
			variant === 'section' && (
				<>
					<path d="M110 20v250M290 20v250" stroke-width="1.5" />
					<path d="M135 60h130v70H135zM135 78h130M135 92h130M135 106h130" stroke-width="1" />
					<path d="M185 130v140M215 130v140" stroke-width="1" />
					<circle cx="200" cy="105" r="9" stroke-width="0.75" />
					<path d="M200 10v270" stroke-width="0.5" stroke-dasharray="10 4 2 4" />
					<path d="M320 60v70M314 60h12M314 130h12" stroke-width="0.75" />
					<text x="332" y="100" class="dim">92</text>
				</>
			)
		}
		{
			variant === 'gear' && (
				<>
					<circle cx="200" cy="140" r="112" stroke-width="16" stroke-dasharray="8.8 8.8" opacity="0.55" />
					<circle cx="200" cy="140" r="102" stroke-width="1.25" />
					<circle cx="200" cy="140" r="78" stroke-width="0.75" />
					<circle cx="200" cy="140" r="28" stroke-width="1.25" />
					<path d="M200 10v260M70 140h260" stroke-width="0.5" stroke-dasharray="10 4 2 4" />
					<text x="200" y="285" text-anchor="middle" class="dim">m 2.5 · z 40</text>
				</>
			)
		}
	</svg>
	<figcaption class="label">{caption}</figcaption>
</figure>

<style>
	figure {
		display: grid;
		gap: var(--space-s);
		color: var(--color-accent);
	}

	svg {
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 4 / 3;
	}

	.dim {
		fill: currentColor;
		stroke: none;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.06em;
	}
</style>
