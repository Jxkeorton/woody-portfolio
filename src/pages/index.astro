---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero/Hero.astro';
import About from '../components/About/About.astro';
import ProjectList from '../components/ProjectList/ProjectList.astro';
import { getProjects, getSiteSettings } from '../utils/sanity';

const [projects, settings] = await Promise.all([getProjects(), getSiteSettings()]);
---

<Base title={settings.siteTitle} description={settings.siteDescription}>
	<Hero settings={settings} />

	<section class="work" id="work" aria-labelledby="work-heading">
		<div class="section-head">
			<h2 id="work-heading">Projects</h2>
			<p class="label">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
		</div>
		<ProjectList projects={projects} />
	</section>

	<About about={settings.about} />
</Base>

<style>
	section {
		max-inline-size: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	/* Work index */
	.work {
		padding-block-start: var(--space-2xl);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-m);
		margin-block-end: var(--space-l);
	}

	h2 {
		font-size: var(--step-3);
		letter-spacing: -0.03em;
		line-height: var(--leading-snug);
	}
</style>
