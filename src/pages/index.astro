---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList/ProjectList.astro';
import { getProjects } from '../utils/sanity';

const projects = await getProjects();

const startLinks = [
	{ href: '#work', label: 'See my projects' },
	{ href: '#about', label: 'Read about me' },
	{ href: '#contact', label: 'Email me' },
];
---

<Base
	title="Woody · Automotive engineering student"
	description="Portfolio of Woody, an automotive engineering student looking for a placement or graduate role. Projects in brakes, powertrain and transmission."
>
	<section class="hero">
		<h1>Woody</h1>
		<div class="hero-grid">
			<div class="statement">
				<p>
					I'm an automotive engineering student who likes to test an idea, measure what happened and fix
					what didn't work.
				</p>
				<p class="label">Automotive engineering student<br />Open to placements and graduate roles</p>
			</div>
			<nav class="start" aria-labelledby="start-label">
				<p class="label" id="start-label">Where you can start</p>
				<ul>
					{
						startLinks.map(({ href, label }) => (
							<li>
								<a href={href}>{label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</section>

	<section class="work" id="work" aria-labelledby="work-heading">
		<div class="section-head">
			<h2 id="work-heading">Projects</h2>
			<p class="label">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
		</div>
		<ProjectList projects={projects} />
	</section>

	<section class="about" id="about" aria-labelledby="about-heading">
		<h2 id="about-heading">About</h2>
		<p>
			I'm in my third year of an automotive engineering degree. I learn the most when something goes
			wrong: a simulation that disagreed with the test, a design that couldn't be machined. Each
			project here shows the method and the numbers, not just the result.
		</p>
	</section>
</Base>

<style>
	section {
		max-inline-size: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	/* Hero */
	.hero {
		padding-block: var(--space-xl) 0;
	}

	h1 {
		font-size: var(--step-5);
		font-weight: var(--weight-hero);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-display);
		color: var(--color-text-soft);
		margin-inline-start: -0.04em;
	}

	.hero-grid {
		display: grid;
		gap: var(--space-xl);
		margin-block-start: var(--space-xl);
	}

	@media (min-width: 56rem) {
		.hero-grid {
			grid-template-columns: 1.2fr 1fr;
			gap: var(--space-2xl);
		}
	}

	.statement {
		display: grid;
		gap: var(--space-m);
		align-content: start;
	}

	.statement p:first-child {
		max-inline-size: 22ch;
		font-size: var(--step-2);
		line-height: var(--leading-snug);
		color: var(--color-text-soft);
	}

	.start ul {
		display: grid;
		margin-block-start: var(--space-s);
		padding: 0;
		list-style: none;
		border-block-start: var(--border-hairline);
	}

	.start li {
		border-block-end: var(--border-hairline);
	}

	.start a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-block-size: var(--tap-target);
		padding-block: var(--space-xs);
		text-decoration: none;
		color: var(--color-text-soft);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.start a::after {
		content: '→';
		color: var(--color-accent);
		transition: transform var(--duration-base) var(--ease-out);
	}

	.start a:hover {
		color: var(--color-accent);
	}

	.start a:hover::after {
		transform: translateX(0.35em);
	}

	/* Work index */
	.work {
		padding-block-start: var(--space-2xl);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-m);
		margin-block-end: var(--space-l);
	}

	h2 {
		font-size: var(--step-3);
		letter-spacing: -0.03em;
		line-height: var(--leading-snug);
	}

	/* About */
	.about {
		display: grid;
		gap: var(--space-s);
		padding-block-start: var(--space-2xl);
	}

	@media (min-width: 56rem) {
		.about {
			grid-template-columns: 1fr 2fr;
			gap: var(--space-2xl);
		}
	}

	.about h2 {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		line-height: var(--leading-body);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.about p {
		max-inline-size: 36ch;
		font-size: var(--step-2);
		line-height: var(--leading-snug);
		color: var(--color-text-soft);
	}
</style>
