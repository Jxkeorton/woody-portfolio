---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero/Hero.astro';
import About from '../components/About/About.astro';
import Experience from '../components/Experience/Experience.astro';
import Education from '../components/Education/Education.astro';
import CvDownload from '../components/CvDownload/CvDownload.astro';
import Skills from '../components/Skills/Skills.astro';
import HomeProjects from '../components/HomeProjects/HomeProjects.astro';
import { getCv, getProjects, getSiteSettings } from '../utils/sanity';

const [projects, settings, cv] = await Promise.all([getProjects(), getSiteSettings(), getCv()]);
---

<Base title={settings.siteTitle} description={settings.siteDescription}>
	<Hero settings={settings} />

	<HomeProjects projects={projects} />

	<About about={settings.about} profileImage={settings.profileImage} />
	<Experience entries={cv.experience} />
	<Education entries={cv.qualifications} />
	<CvDownload file={cv.cvFile} name={settings.name} />
	<Skills skills={settings.skills} />
</Base>
