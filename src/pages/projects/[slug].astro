---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail/ProjectDetail.astro';
import NextProject from '../../components/NextProject/NextProject.astro';
import { nextProject } from '../../utils/project';
import { getProject, getProjects, getSiteSettings } from '../../utils/sanity';

export const getStaticPaths = (async () => {
	const summaries = await getProjects();
	const projects = await Promise.all(summaries.map(({ slug }) => getProject(slug)));
	return projects.flatMap((project) =>
		project
			? [{ params: { slug: project.slug }, props: { project, next: nextProject(summaries, project.slug) } }]
			: [],
	);
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { name } = await getSiteSettings();
---

<Base title={`${project.title} · ${name}`} description={`${project.system}. ${project.context}.`}>
	<ProjectDetail project={project} />
	<NextProject project={next} />
</Base>
